{
  "name": "grain-logistics-app",
  "version": "1.0.0",
  "description": "Aplikacja do zarządzania awizacjami pojazdów w punktach skupu zbóż",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "start": "node scripts/start-app.js",
    "start:fast": "electron .",
    "start:rebuild": "cross-env AWIZAXJA_FORCE_BUILD=1 node scripts/start-app.js",
    "start:build": "node scripts/start-app.js",
    "dev": "concurrently \"npm run dev:react\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "dev:react": "react-scripts start",
    "build": "node scripts/build.js",
    "build:prod": "npm run build && electron-builder --publish=never",
    "test": "react-scripts test",
    "test:db": "node scripts/test-db.js",
    "test:sqljs": "node scripts/test-sqljs.js",
    "test:e2e": "electron scripts/test-app-e2e.js",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "dist": "node scripts/prepare-assets.js && npm run build && electron-builder --publish=never",
    "pack": "node scripts/prepare-assets.js && npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "@mui/x-data-grid": "^8.9.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.10.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^25.3.1",
    "electron-builder": "^24.6.3",
    "react-scripts": "^5.0.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "extends": null,
    "appId": "com.grainlogistics.app",
    "productName": "Grain Logistics",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "node_modules/sql.js/dist/**/*",
      "schema.sql"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
